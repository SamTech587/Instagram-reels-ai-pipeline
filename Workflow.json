      "parameters": {
        "jsCode": "const raw = $input.first().json.stdout;\nconst jsonStart = raw.indexOf('{\"Reels\"');\nif (jsonStart === -1) {\n    return [{ json: { error: 'No JSON found in output' } }];\n}\nconst cleanJson = raw.substring(jsonStart);\nconst parsed = JSON.parse(cleanJson);\nreturn parsed.Reels.map(reel => ({\n    json: {\n        'Reel URL': reel.url,\n        'Caption': reel.caption || '',\n        'Date Saved': reel.date || new Date().toISOString().split('T')[0],\n        'Caption Status': reel.status,\n        'ocrText': reel.ocrText || '',\n        'audioPath': reel.audioPath || ''\n    }\n}));"
      },
